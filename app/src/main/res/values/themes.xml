<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LionRay" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_dark</item>
        <item name="android:statusBarColor">#FAF0F4</item>
        <item name="android:navigationBarColor">#F0FAF3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
    </style>

    <style name="Text.LionRay.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
    </style>
</resources>
