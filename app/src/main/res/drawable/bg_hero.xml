<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sunset aurora panel: warm orange -> pink -> royal violet -->
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#FF8A5C"
                android:centerColor="#FF4E8E"
                android:endColor="#8E2DE2" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <!-- white glow, top-right -->
    <item
        android:right="-130dp"
        android:top="-150dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFFFFF"
                android:gradientRadius="240dp"
                android:startColor="#40FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <!-- soft pink glow, bottom-left -->
    <item
        android:bottom="-160dp"
        android:left="-110dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFD1E3"
                android:gradientRadius="260dp"
                android:startColor="#38FFD1E3"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
